# Copy to .env and edit locally. Never send the key in chat.
DASHSCOPE_API_KEY=replace_with_your_key
# Beijing endpoint; key, model permissions and endpoint must match the region.
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v1
EMBEDDING_DIM=1536
LLM_MODEL=qwen-plus
MILVUS_URI=http://127.0.0.1:19530
PAPER_PATH=papers/paper.pdf
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# Optional cutoff; smaller raw L2 distance is closer. Not a confidence score.
MAX_L2_DISTANCE=

# Retrieval only: changing these does not require reindexing.
RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
RETRIEVAL_CANDIDATES=20
